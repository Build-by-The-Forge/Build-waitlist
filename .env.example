# Public site URL, used for canonical URLs, sitemap, and Origin checks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres connection string. Required (signups need it for email verification).
# Use a development database locally, never production.
DATABASE_URL=

# Optional: comma-separated extra origins allowed to POST /api/waitlist (e.g. preview deploys).
WAITLIST_ALLOWED_ORIGINS=

# --- Admin dashboard (/admin) ---------------------------------------------
# Random secret for signing admin sessions: `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URI: <site url>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# The one Google account allowed to become the first admin. Only used while
# waitlist.admin_users is empty; after that, admins are managed in the database.
ADMIN_BOOTSTRAP_EMAIL=

# --- Email verification ------------------------------------------------------
# "resend" in production. Unset or "console" in development prints the
# verification link to the server log instead of sending (not allowed in production).
EMAIL_PROVIDER=
# Resend API key (resend.com > API Keys). Server-side only.
EMAIL_API_KEY=
# Sender on a domain verified in Resend, e.g. "BUILD <hello@mail.yourdomain.com>".
EMAIL_FROM=
# Optional monitored inbox for replies (e.g. deletion requests).
EMAIL_REPLY_TO=
# Optional tuning (defaults shown).
# VERIFICATION_TOKEN_TTL_HOURS=24
# VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# VERIFICATION_MAX_SENDS_PER_DAY=5
# Optional salt for hashed rate-limit buckets (defaults to AUTH_SECRET).
# RATE_LIMIT_SALT=
