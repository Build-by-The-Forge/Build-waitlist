# Public site URL, used for canonical URLs, sitemap, and Origin checks.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Postgres connection string. Required (signups need it for email verification).
# Use a development database locally, never production. Production (Supabase):
# postgresql://waitlist_app.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require
DATABASE_URL=

# Privileged migration connection for local development only. Keep this
# separate from the runtime DATABASE_URL, especially in production.
MIGRATION_DATABASE_URL=

# Optional: comma-separated extra origins allowed to POST /api/waitlist (e.g. preview deploys).
WAITLIST_ALLOWED_ORIGINS=

# --- Admin dashboard (/admin) ---------------------------------------------
# Random secret for signing admin sessions: `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URI: <site url>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Deployment-time seeds: up to three Google accounts that may bootstrap
# themselves as admins, only while fewer than three waitlist.admin_users rows
# exist. After that, admins are managed in the database (see README).
ADMIN_BOOTSTRAP_EMAIL_1=
ADMIN_BOOTSTRAP_EMAIL_2=
ADMIN_BOOTSTRAP_EMAIL_3=

# --- Email verification ------------------------------------------------------
# Primary provider: "brevo" in production (Resend is the automatic fallback
# when RESEND_API_KEY is set). Unset or "console" in development prints the
# verification link to the server log instead of sending (not allowed in production).
EMAIL_PROVIDER=
# Optional: force the fallback ("resend" | "brevo") or disable it ("none").
# EMAIL_FALLBACK_PROVIDER=
# Brevo API key (Brevo > SMTP & API > API keys). Server-side only.
BREVO_API_KEY=
# Resend API key (resend.com > API Keys), used for fallback. Server-side only.
RESEND_API_KEY=
# Sender address on a domain verified in BOTH providers, e.g. hello@mail.yourdomain.com
EMAIL_FROM=
EMAIL_FROM_NAME=BUILD
# Optional monitored inbox for replies (e.g. deletion requests).
EMAIL_REPLY_TO=
# Optional: public origin hosting the logo image used in emails. Only needed when
# NEXT_PUBLIC_SITE_URL is localhost (Gmail can't load images from your machine),
# e.g. your deployed site. Without it, local emails show a text "B" badge instead.
# EMAIL_ASSET_BASE_URL=
# Optional tuning (defaults shown).
# VERIFICATION_TOKEN_TTL_HOURS=24
# VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# VERIFICATION_MAX_SENDS_PER_DAY=5
# Optional salt for hashed rate-limit buckets (defaults to AUTH_SECRET).
# RATE_LIMIT_SALT=

# Optional, operator checks only: the restricted waitlist_app runtime role,
# used to verify its grants. Never used by the app or the migration scripts.
WAITLIST_APP_DATABASE_URL=
